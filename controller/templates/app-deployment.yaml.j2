apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: {{ deployment_name }}-secrets
  namespace: {{ namespace }}
  labels:
    shipzen.jeneeldumasia.codes/project: "{{ project_name }}"
spec:
  refreshInterval: "1h"
  secretStoreRef:
    # Tenant store: its Google identity can only read shipzen-project-* secrets,
    # and Kyverno only lets this ExternalSecret read its own project's (C6).
    name: gcp-secret-manager-tenants
    kind: ClusterSecretStore
  target:
    name: {{ deployment_name }}-secrets-sync
    creationPolicy: Owner
  dataFrom:
    - extract:
        # Secrets in GCP Secret Manager are stored as a JSON object with this key
        key: shipzen-project-{{ project_id }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ deployment_name }}
  namespace: {{ namespace }}
  labels:
    app: {{ deployment_name }}
    shipzen.jeneeldumasia.codes/project: "{{ project_name }}"
  annotations:
    # size:min:max this manifest was rendered for (the controller re-renders on change)
    shipzen.jeneeldumasia.codes/scaling: "{{ scaling_key | default('small:1:1') }}"
spec:
{%- if not autoscale %}
  replicas: {{ replicas | default(1) }}
{%- endif %}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app: {{ deployment_name }}
  template:
    metadata:
      labels:
        app: {{ deployment_name }}
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "{{ port | default(8080) }}"
        prometheus.io/path: "/metrics"
    spec:
      # Tenant apps run on their own node pool, sandboxed with gVisor (security
      # finding C5), never next to the platform or builds.
      runtimeClassName: gvisor
      nodeSelector:
        shipzen.jeneeldumasia.codes/node-type: tenant
      # Fix #5.4: toleration to schedule on the dedicated tenant NodePool.
      # Tenant nodes are tainted shipzen.jeneeldumasia.codes/dedicated=tenant:NoSchedule
      # so builder workloads cannot mix with tenant app pods.
      tolerations:
        - key: shipzen.jeneeldumasia.codes/dedicated
          operator: Equal
          value: tenant
          effect: NoSchedule
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: app
          lifecycle:
            preStop:
              exec:
                command: ["/bin/sleep", "5"]
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          image: {{ image_uri }}
          env:
            - name: PORT
              value: "{{ port | default(8080) }}"
            - name: NIXPACKS_SPA_OUTPUT_DIR
              value: "dist"
          resources:
            requests:
              cpu: "{{ cpu_request | default('100m') }}"
              memory: "{{ memory_request | default('128Mi') }}"
            limits:
              cpu: "{{ cpu_limit | default('500m') }}"
              memory: "{{ memory_limit | default('512Mi') }}"
          envFrom:
            - secretRef:
                name: {{ deployment_name }}-secrets-sync
                optional: true
          ports:
            - name: http
              containerPort: {{ port | default(8080) }}
          volumeMounts:
            - name: tmp-volume
              mountPath: /tmp
          startupProbe:
            httpGet:
              path: {{ health_check_path | default('/') | tojson }}
              port: {{ port | default(8080) }}
            initialDelaySeconds: 2
            periodSeconds: 5
            failureThreshold: 30
          readinessProbe:
            httpGet:
              path: {{ health_check_path | default('/') | tojson }}
              port: {{ port | default(8080) }}
            initialDelaySeconds: 5
            periodSeconds: 10
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: {{ health_check_path | default('/') | tojson }}
              port: {{ port | default(8080) }}
            initialDelaySeconds: 15
            periodSeconds: 20
            failureThreshold: 3
      volumes:
        - name: tmp-volume
          emptyDir:
            sizeLimit: 1Gi
---
apiVersion: v1
kind: Service
metadata:
  name: {{ deployment_name }}-svc
  namespace: {{ namespace }}
  labels:
    app: {{ deployment_name }}
    shipzen.jeneeldumasia.codes/project: "{{ project_name }}"
spec:
  selector:
    app: {{ deployment_name }}
  ports:
    - protocol: TCP
      port: 80
      targetPort: {{ port | default(8080) }}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ deployment_name }}-route
  namespace: {{ namespace }}
  labels:
    shipzen.jeneeldumasia.codes/project: "{{ project_name }}"
spec:
  parentRefs:
    - name: shipzen-gateway
      namespace: shipzen-system
  hostnames:
    - "{{ deployment_id[:8] }}-{{ project_name }}-shipzen.jeneeldumasia.codes"
  rules:
    - backendRefs:
        - name: {{ deployment_name }}-svc
          port: 80
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: {{ deployment_name }}-pdb
  namespace: {{ namespace }}
  labels:
    shipzen.jeneeldumasia.codes/project: "{{ project_name }}"
spec:
  # Fix #19: minAvailable: 1 on a single-replica deployment makes the pod
  # permanently un-evictable, blocking cluster-autoscaler scale-down and node drains.
  # Use maxUnavailable: 1 instead — this allows voluntary evictions while
  # still protecting multi-replica deployments from losing all pods at once.
  maxUnavailable: 1
  selector:
    matchLabels:
      app: {{ deployment_name }}
{%- if autoscale %}
---
# Live release with max > min instances: CPU autoscaling. The Deployment above
# leaves replicas unset so neither ArgoCD nor the controller fights the HPA.
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ deployment_name }}-hpa
  namespace: {{ namespace }}
  labels:
    shipzen.jeneeldumasia.codes/project: "{{ project_name }}"
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{ deployment_name }}
  minReplicas: {{ min_instances }}
  maxReplicas: {{ max_instances }}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
{%- endif %}
